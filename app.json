{
  "expo": {
    "name": "CatCare",
    "slug": "catcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F0"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourteam.catcare",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "고양이 사진을 찍기 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "고양이 사진을 선택하기 위해 사진 접근이 필요합니다.",
        "NSUserNotificationsUsageDescription": "미완료 루틴 알림을 보내기 위해 알림 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6F0"
      },
      "package": "com.yourteam.catcare",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C4956A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "고양이 사진을 선택하기 위해 사진 접근이 필요합니다."
        }
      ]
    ],
    "scheme": "catcare",
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
