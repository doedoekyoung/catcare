{
  "expo": {
    "name": "CatCare",
    "slug": "catcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.catcare.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "고양이 사진을 찍기 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "고양이 사진을 선택하기 위해 사진 접근이 필요합니다.",
        "NSUserNotificationsUsageDescription": "미완료 루틴 알림을 보내기 위해 알림 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6F0"
      },
      "package": "com.catcare.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "ko"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C4956A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "고양이 사진을 선택하기 위해 사진 접근이 필요합니다."
        }
      ]
    ],
    "scheme": "catcare",
    "extra": {
      "eas": {
        "projectId": "418bff92-9284-4c73-86b0-bed7d7ca821d"
      }
    },
    "owner": "doedoe"
  }
}
